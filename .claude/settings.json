{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "py scripts/lint_touched_file.py",
            "timeout": 30,
            "statusMessage": "Checking imports and names with ruff..."
          }
        ]
      }
    ]
  }
}
